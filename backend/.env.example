# ---- App ----
APP_NAME="AI Sales & Lead Agent"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Comma-separated. Add your real public website's origin here (e.g.
# https://novulabs.net) so the embeddable chat widget's browser requests
# aren't blocked.
CORS_ORIGINS=http://localhost:5173

# ---- Database (PostgreSQL with pgvector extension) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sales_agent

# ---- WhatsApp Business Cloud API ----
# Create a Meta app + WhatsApp product at https://developers.facebook.com
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-a-verify-token
WHATSAPP_API_VERSION=v21.0
WHATSAPP_APP_SECRET=

# ---- LLM (Google Gemini) ----
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=3072

# ---- Sales Manager notification ----
# NOTIFICATION_CHANNEL: log | whatsapp | email
NOTIFICATION_CHANNEL=log
SALES_MANAGER_WHATSAPP_NUMBER=
SALES_MANAGER_EMAIL=

# ---- Website knowledge source ----
WEBSITE_URL=https://example.com

# ---- RAG tuning ----
RAG_TOP_K=10
CHUNK_SIZE=800
CHUNK_OVERLAP=120
CONVERSATION_HISTORY_LIMIT=20

# ---- First dashboard admin (created by `python manage.py bootstrap_admin`) ----
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-me-please
