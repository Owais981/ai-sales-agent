# Base URL of the deployed chat backend (the one exposing /api/website-chat/*).
# Used by app/layout.tsx to point the chat widget script at the right server.
# Set the real value in .env.production and in your host's project env vars
# (e.g. Vercel > Project Settings > Environment Variables).
NEXT_PUBLIC_CHAT_API_URL=https://your-backend-domain.example
